# ==============================================================================
# Environment Configuration - Proyecto Final ETL
# Copiar a .env y ajustar valores si es necesario.
# PROHIBIDO COMITEAR EL ARCHIVO .env CON CREDENCIALES REALES
# ==============================================================================

# Database Configuration (PostgreSQL 16 Data Warehouse & Streaming Store)
DB_HOST=postgres_dw
DB_PORT=5432
DB_NAME=etl_dw
DB_USER=postgres
DB_PASSWORD=postgres123

# Kafka Broker Configuration
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TOPIC_VIOLENCIA=violencia-intrafamiliar-events
KAFKA_CONSUMER_GROUP=etl_streaming_group

# API Configuration (datos.gov.co SODA API - Comisarías de Familia)
API_BASE_URL=https://www.datos.gov.co/resource/7tuu-upb2.json
API_APP_TOKEN=
API_TIMEOUT_SECONDS=30
API_PAGE_LIMIT=2000

# Primary Source Configuration (DIJIN - Reporte Delito Violencia Intrafamiliar)
PRIMARY_DATA_URL=https://www.datos.gov.co/api/views/vuyt-mqpw/rows.csv?accessType=DOWNLOAD

# Airflow Configuration
AIRFLOW_UID=50000
_AIRFLOW_WWW_USER_USERNAME=admin
_AIRFLOW_WWW_USER_PASSWORD=admin

# General Environment
PIPELINE_ENVIRONMENT=development
LOG_LEVEL=INFO

