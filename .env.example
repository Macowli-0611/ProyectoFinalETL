# ==============================================================================
# Environment configuration - Final ETL Delivery
# Copy to .env and set your own values:   cp .env.example .env
# .env is git-ignored. NEVER commit real credentials.
# ==============================================================================

# PostgreSQL (Data Warehouse + streaming store)
# Inside Docker the services always use host "postgres_dw"; the values below are
# used by docker compose AND by scripts you run from your host machine.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=etl_dw
DB_USER=postgres
DB_PASSWORD=change_me_local_only

# Kafka - from the host use 127.0.0.1:9092 (inside Docker it is kafka:29092)
KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:9092
KAFKA_TOPIC_VIOLENCIA=violencia-intrafamiliar-events
KAFKA_CONSUMER_GROUP=etl_streaming_group

# datos.gov.co SODA API - Comisarías de Familia (token optional, raises rate limit)
API_BASE_URL=https://www.datos.gov.co/resource/7tuu-upb2.json
API_APP_TOKEN=
API_TIMEOUT_SECONDS=30
API_PAGE_LIMIT=2000

# Primary source - Policía Nacional DIJIN (Reporte Delito Violencia Intrafamiliar)
PRIMARY_DATA_URL=https://www.datos.gov.co/api/views/vuyt-mqpw/rows.csv?accessType=DOWNLOAD

# true = re-download the DIJIN CSV on every scheduled DAG run
PRIMARY_FORCE_REFRESH=false
